# แบบฟอร์มตัวแปรสำหรับ production (Railway -> service ของบอท -> Variables)
#
# Railway ไม่ได้อ่านไฟล์นี้ ต้องคัดลอกไปใส่ทีละตัวในหน้า Variables
# ห้ามใส่ค่าจริงลงไฟล์นี้เพราะมันขึ้น git

# ── บอท Discord ──────────────────────────────────────────
# token ของแอปที่ใช้กับเซิร์ฟจริง (ถ้าสร้างแอปใหม่แยกจากตัวทดสอบ ใช้ token ของตัวใหม่)
# ห้ามเปิดบอท token เดียวกันพร้อมกัน 2 ที่ (เครื่องตัวเอง + Railway) จะทำงานซ้อนกันจนข้อมูลเพี้ยน
DISCORD_TOKEN=

# เซิร์ฟจริง CLOVER_TH_GUILD
GUILD_ID=1531938591016751254

# ต้องเปิด MESSAGE CONTENT INTENT ใน Developer Portal ของแอปนั้นด้วย ไม่งั้น login ไม่ผ่าน
MESSAGE_CONTENT_INTENT=true

# ── ต่อกับ backend ───────────────────────────────────────
API_BASE_URL=https://<โดเมนจริงของ backend>

# "bot key" จาก npm run hash-bot-key -- --generate (รอบเดียวกับ digest ที่ใส่ BOT_API_KEYS ฝั่ง backend)
API_BOT_KEY=

# ── ที่เก็บสถานะ onboarding ──────────────────────────────
# ไฟล์นี้เก็บว่าใครกรอก IGN แล้ว ใครรออนุมัติอยู่
# บน Railway ระบบไฟล์จะถูกล้างทุกครั้งที่ deploy ใหม่ ต้องผูก Volume ไว้ที่ /data
# แล้วตั้งค่านี้ให้ชี้เข้าไปใน volume ไม่งั้นคนที่กำลังรออนุมัติจะข้อมูลหาย
ONBOARDING_FILE=/data/onboarding.json
