# ต้องเปิด MESSAGE CONTENT INTENT ใน Developer Portal ก่อน ไม่งั้นบอท login ไม่ผ่าน
# จำเป็นสำหรับ: ดึงข้อมูลแนะนำตัวของสมาชิกเก่า และแก้การ์ดแนะนำตัวเดิมแทนการโพสต์ซ้ำ
MESSAGE_CONTENT_INTENT=false
