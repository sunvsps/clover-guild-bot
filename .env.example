# backend (clover-guild-project) — ตอนรันในเครื่องใช้ localhost ได้เลย ไม่ต้องมี URL สาธารณะ
API_BASE_URL=http://localhost:3000
# คีย์ตัวจริงจาก: cd backend && npm run hash-bot-key -- --generate (ค่า digest ไปใส่ BOT_API_KEYS ฝั่ง backend)
